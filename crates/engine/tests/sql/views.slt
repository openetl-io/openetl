# Views name a result later statements read: inlined into each reader, so
# a filter or a rename in a view runs in the statement, and keys pass
# through views by the same rule.

control sortmode rowsort

statement ok
CREATE TABLE customers (id BIGINT NOT NULL, email TEXT, country TEXT, PRIMARY KEY (id))

statement ok
INSERT INTO customers VALUES (1, 'A@x.io', 'EU'), (2, NULL, 'US'), (3, 'C@y.io', 'US'), (4, 'd@x.io', NULL)

# A view needs a name of its own.
statement error
CREATE VIEW customers AS SELECT id FROM customers
----
name 1:13 view customers has a source stream's name: a view needs a name of its own


statement ok
CREATE VIEW cleaned AS SELECT id, lower(email) AS email, country FROM customers WHERE email IS NOT NULL

query IT
SELECT id AS customer, email FROM cleaned WHERE country = 'US'
----
3 c@y.io

query ITT
SELECT * FROM cleaned
----
1 a@x.io EU
3 c@y.io US
4 d@x.io NULL

# A view of a view.
statement ok
CREATE VIEW renamed AS SELECT id AS customer_id, upper(email) AS email FROM cleaned

query IT
SELECT customer_id, email FROM renamed WHERE customer_id > 1
----
3 C@Y.IO
4 D@X.IO

query IT
SELECT r.customer_id, r.email FROM renamed AS r
----
1 A@X.IO
3 C@Y.IO
4 D@X.IO

# Names of views match without regard to case.
query I
SELECT customer_id FROM RENAMED
----
1
3
4

# A rename through views keeps the key; an expression drops it.
onlyif openetl
query TTT nosort
DESCRIBE SELECT customer_id, email FROM renamed
----
customer_id Int64 not null key
email Utf8 null

statement ok
CREATE VIEW shifted AS SELECT id + 100 AS id, email FROM customers

onlyif openetl
query TTT nosort
DESCRIBE SELECT id, email FROM shifted
----
id Int64 not null
email Utf8 null

query IT
SELECT id, email FROM shifted
----
101 A@x.io
102 NULL
103 C@y.io
104 d@x.io

# Several statements of one transform, each its own output, reading the
# same view. A statement's output isn't something FROM reads.
onlyif openetl
query TIT
INSERT INTO eu SELECT id, email FROM cleaned WHERE country = 'EU';
INSERT INTO us SELECT id, email FROM cleaned WHERE country = 'US'
----
eu 1 a@x.io
us 3 c@y.io

# An output that replaces the stream it reads.
onlyif openetl
query IT
INSERT INTO customers SELECT id, lower(email) AS email FROM customers
----
1 a@x.io
2 NULL
3 c@y.io
4 d@x.io

# What views refuse.
statement error
CREATE VIEW cleaned AS SELECT id FROM customers
----
name 1:13 there's already a view cleaned


statement error
CREATE VIEW public.v AS SELECT id FROM customers
----
name 1:13 a view's name is one identifier, never qualified: quote it, as "public.v", if it has dots


statement error
CREATE VIEW v (a) AS SELECT id FROM customers
----
unsupported 1:13 CREATE VIEW takes a name and AS SELECT, and nothing else: the SELECT names the view's columns


query error
SELECT id FROM source.cleaned
----
name 1:16 cleaned is a view, and views take no qualifier: write FROM cleaned


query error
SELECT id FROM nope
----
name 1:16 there's no stream or view nope


# A view defined after the statement that reads it isn't there yet.
onlyif openetl
statement error
INSERT INTO x SELECT id FROM later;
CREATE VIEW later AS SELECT id FROM customers
----
name 1:30 view later is defined after this statement: define a view before the statements that read it


# A view that has an output's name.
onlyif openetl
statement error
INSERT INTO out SELECT id FROM customers;
CREATE VIEW out AS SELECT id FROM customers
----
name 2:13 view out has an output's name: a view needs a name of its own


# A view's later-tier SQL is refused where it's written.
statement error
CREATE VIEW counted AS SELECT country, count(*) AS n FROM customers GROUP BY country
----
later_tier updating 1:78 GROUP BY without a window: transforms don't run updating statements yet (tier 5)
