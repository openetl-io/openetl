# WHERE: a row passes where the predicate is true, and not where it's false
# or null.

control sortmode rowsort

statement ok
CREATE TABLE orders (id BIGINT NOT NULL, region TEXT, amount DECIMAL(12, 2), qty INTEGER, paid BOOLEAN, note TEXT, PRIMARY KEY (id))

statement ok
INSERT INTO orders VALUES (1, 'eu', 120.00, 3, true, 'gift'), (2, 'us', 9.99, 1, false, NULL), (3, NULL, NULL, NULL, NULL, 'rush order'), (4, 'EU', 45.50, 0, true, ''), (5, 'apac', 1000.01, 12, false, 'gift wrap')

query I
SELECT id FROM orders WHERE amount > 50
----
1
5

query I
SELECT id FROM orders WHERE amount > 50 AND paid
----
1

query I
SELECT id FROM orders WHERE amount > 50 OR region = 'us'
----
1
2
5

# Null is false: neither side of a comparison with null passes.
query I
SELECT id FROM orders WHERE region = 'eu'
----
1

query I
SELECT id FROM orders WHERE NOT (region = 'eu')
----
2
4
5

query I
SELECT id FROM orders WHERE region IS NULL
----
3

query I
SELECT id FROM orders WHERE region IS NOT DISTINCT FROM NULL OR qty = 0
----
3
4

query I
SELECT id FROM orders WHERE (region IS NOT DISTINCT FROM NULL) OR qty = 0
----
3
4

# Precedence, as in Postgres and DuckDB: OR, then AND, then NOT, then IS,
# then comparisons, then BETWEEN, IN, LIKE and SIMILAR TO, then the other
# operators. The right side of IS DISTINCT FROM ends where an operator that
# binds as loosely as IS starts.
query I
SELECT id FROM orders WHERE region IS DISTINCT FROM 'eu' AND paid
----
4

query I
SELECT id FROM orders WHERE id = 3 AND region IS DISTINCT FROM 'us' OR id = 1 AND region IS DISTINCT FROM 'eu' AND id > 0
----
3

query I
SELECT id FROM orders WHERE paid IS DISTINCT FROM qty > 2
----
4
5

query I
SELECT id FROM orders WHERE qty > 2 IS DISTINCT FROM paid
----
4
5

query I
SELECT id FROM orders WHERE (region = 'eu') IS DISTINCT FROM (qty = 0 OR qty = 1)
----
1
2
4

query I
SELECT id FROM orders WHERE NOT region IS DISTINCT FROM 'eu' OR qty = 1
----
1
2

query I
SELECT id FROM orders WHERE qty IS DISTINCT FROM 1 + 2 AND paid IS NOT NULL
----
2
4
5

query I
SELECT id FROM orders WHERE paid IS NOT DISTINCT FROM note LIKE 'gift%' OR qty = 1
----
1
2

query I
SELECT id FROM orders WHERE paid IS DISTINCT FROM qty BETWEEN 1 AND 3 AND region IS NOT NULL
----
2
4

query I
SELECT id FROM orders WHERE region IS NULL OR qty = 0
----
3
4

query I
SELECT id FROM orders WHERE NOT region IS NULL AND qty > 2
----
1
5

query I
SELECT id FROM orders WHERE NOT paid IS TRUE
----
2
3
5

query I
SELECT id FROM orders WHERE amount > 50 IS NOT FALSE OR qty = 0
----
1
3
4
5

query I
SELECT id FROM orders WHERE paid IS UNKNOWN OR qty = 1
----
2
3

query I
SELECT id FROM orders WHERE qty BETWEEN 1 AND 3 AND paid
----
1

query I
SELECT id FROM orders WHERE qty NOT BETWEEN 1 AND 3 OR region = 'us'
----
2
4
5

query I
SELECT id FROM orders WHERE qty BETWEEN 0 AND 1 = paid
----
4
5

query I
SELECT id FROM orders WHERE qty BETWEEN 1 AND 1 + 2
----
1
2

query I
SELECT id FROM orders WHERE region IN ('eu', 'us') = paid
----
1
5

query I
SELECT id FROM orders WHERE region NOT IN ('eu') AND qty > 0
----
2
5

query I
SELECT id FROM orders WHERE note LIKE 'gift%' = paid
----
1

query I
SELECT id FROM orders WHERE paid = note LIKE 'gift%'
----
1

query I
SELECT id FROM orders WHERE note LIKE 'gift' || '%'
----
1
5

query I
SELECT id FROM orders WHERE note NOT LIKE 'gift%' OR qty = 3
----
1
3
4

query I
SELECT id FROM orders WHERE note SIMILAR TO 'gift.*' OR qty = 0
----
1
4
5

query IT
SELECT id, CASE WHEN region IS DISTINCT FROM 'eu' AND paid THEN 'y' ELSE 'n' END AS c FROM orders
----
1 n
2 n
3 n
4 y
5 n

query IT
SELECT id, coalesce(region IS NOT DISTINCT FROM 'eu' OR qty = 0, false) AS c FROM orders
----
1 true
2 false
3 false
4 true
5 false

query I
SELECT id FROM orders WHERE paid
----
1
4

query I
SELECT id FROM orders WHERE NOT paid
----
2
5

query I
SELECT id FROM orders WHERE paid IS NOT TRUE
----
2
3
5

query I
SELECT id FROM orders WHERE region IN ('eu', 'EU', 'apac')
----
1
4
5

query I
SELECT id FROM orders WHERE region NOT IN ('eu', 'us')
----
4
5

query I
SELECT id FROM orders WHERE qty BETWEEN 1 AND 3
----
1
2

query I
SELECT id FROM orders WHERE note LIKE 'gift%'
----
1
5

query I
SELECT id FROM orders WHERE note ILIKE '%ORDER'
----
3

query I
SELECT id FROM orders WHERE note = ''
----
4

query I
SELECT id FROM orders WHERE lower(region) = 'eu' AND amount * qty > 100
----
1

query I
SELECT id FROM orders WHERE coalesce(paid, false) = false
----
2
3
5

query I
SELECT id FROM orders WHERE TRUE
----
1
2
3
4
5

query I
SELECT id FROM orders WHERE FALSE
----

# The filter reads columns the output leaves out.
query IT
SELECT id, note FROM orders WHERE amount < 100 AND region IS NOT NULL
----
2 NULL
4 (empty)

# A filter on an output column's name reads the stream's column of that
# name, not the expression's.
query IT
SELECT id, upper(region) AS region FROM orders WHERE region = 'eu'
----
1 EU

# A filter that keeps every row, and one that keeps none, keep the key.
onlyif openetl
query TTT nosort
DESCRIBE SELECT id AS order_id, amount FROM orders WHERE amount > 50
----
order_id Int64 not null key
amount Decimal128(12, 2) null
