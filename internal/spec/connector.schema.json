{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openetl.io/schemas/connector/v1alpha2.json",
  "title": "openetl connector descriptor",
  "description": "A connector package's version: its metadata, and each role's runtime and spec. `openetl connector package` writes it from openetl-connector.yaml; it isn't written by hand.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "openetl.io/v1alpha2" },
    "kind": { "const": "Connector" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "repository"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The package: owner/name, or name for the official owner, openetl. Each part is lowercase letters, digits and hyphens, at most 63 characters.",
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/)?[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "version": {
          "description": "Semantic version.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "title": { "description": "A display name, such as PostgreSQL. None: the name.", "type": "string", "maxLength": 100, "pattern": "^[^\\r\\n]*$" },
        "description": { "description": "One line.", "type": "string", "maxLength": 500, "pattern": "^[^\\r\\n]*$" },
        "license": { "description": "An SPDX expression, such as Apache-2.0.", "type": "string", "pattern": "^[A-Za-z0-9.+:()\\- ]{1,100}$" },
        "repository": { "description": "The source repository. The package's name stays with it.", "$ref": "#/$defs/https" },
        "docs": { "$ref": "#/$defs/https" },
        "logo": { "description": "An SVG or PNG image, which the UI shows.", "anyOf": [{ "$ref": "#/$defs/https" }, { "$ref": "#/$defs/ociBlob" }] },
        "author": { "type": "string", "maxLength": 200 },
        "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" } },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": { "description": "The git tag the version was built from.", "type": "string", "maxLength": 255, "pattern": "^\\S*$" },
            "url": { "$ref": "#/$defs/https" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["roles"],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "source": { "$ref": "#/$defs/source" },
            "destination": { "$ref": "#/$defs/destination" }
          }
        }
      }
    }
  },
  "$defs": {
    "https": { "type": "string", "maxLength": 2048, "pattern": "^https://[^/?#\\s]+([/?#]\\S*)?$" },
    "ociBlob": { "description": "A blob in an OCI registry, by its digest.", "type": "string", "maxLength": 2048, "pattern": "^oci://[^/@\\s]+/[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}$" },
    "platform": { "description": "os/arch, such as linux/amd64.", "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "duration": { "description": "Such as 90s or 15m.", "type": "string", "pattern": "^-?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h)(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))*$|^0$" },
    "bytes": { "description": "A Kubernetes quantity of bytes, such as 512Mi.", "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|k|M|G|T)?$" },
    "role": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "dependentRequired": { "resplit": ["splits"] },
      "properties": {
        "requires": {
          "description": "What the role needs from the platform.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": { "description": "The connector protocol it speaks; none for a manifest.", "const": "v1" },
            "features": {
              "description": "Additions to the protocol after v1 that it can't run without.",
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$" }
            },
            "platform": {
              "description": "The oldest openetl release it runs on.",
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            }
          }
        },
        "runtime": {
          "description": "At least one of binaries and an image, or a manifest alone.",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["binaries"], "properties": { "binaries": { "minProperties": 1 } } },
            { "required": ["image"] },
            { "required": ["manifest"] }
          ],
          "properties": {
            "binaries": {
              "description": "One executable per platform, downloaded over HTTP and pinned by digest.",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/platform" },
              "additionalProperties": {
                "type": "object",
                "required": ["url"],
                "additionalProperties": false,
                "properties": {
                  "url": { "anyOf": [{ "type": "string", "maxLength": 2048, "pattern": "^https?://[^/?#\\s]+([/?#]\\S*)?$" }, { "$ref": "#/$defs/ociBlob" }] },
                  "digest": { "$ref": "#/$defs/digest" },
                  "attestation": { "anyOf": [{ "$ref": "#/$defs/https" }, { "$ref": "#/$defs/ociBlob" }] }
                }
              }
            },
            "image": {
              "description": "An OCI image index that serves the launch contract under the image contract.",
              "type": "object",
              "required": ["ref", "digest", "platforms"],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "description": "A repository, without a tag or digest.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(\\.[a-z0-9-]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$"
                },
                "digest": { "description": "The index's.", "$ref": "#/$defs/digest" },
                "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } },
                "command": { "description": "The connector's argv, where it isn't the entrypoint.", "type": "array", "items": { "type": "string", "minLength": 1 } },
                "attestation": { "anyOf": [{ "$ref": "#/$defs/https" }, { "$ref": "#/$defs/ociBlob" }] }
              }
            },
            "manifest": { "description": "A DeclarativeSource's spec: the role's whole runtime, run in the platform. Sources only.", "type": "object" }
          }
        },
        "resources": {
          "description": "A container launcher's requests and limits, and the job size the role wants.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]{1,3})?)$" },
            "memory": { "$ref": "#/$defs/bytes" },
            "disk": { "description": "The size of TMPDIR.", "$ref": "#/$defs/bytes" },
            "hint": { "description": "The job size a pipeline of this role starts at when it's sized automatically.", "enum": ["xs", "s", "m", "l", "xl"] }
          }
        },
        "state": {
          "description": "The version of the checkpoint state it writes, and the oldest it reads (at most version).",
          "type": "object",
          "required": ["version", "reads"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "reads": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          }
        },
        "egress": {
          "type": "object",
          "required": ["tier"],
          "additionalProperties": false,
          "properties": {
            "tier": { "enum": ["host", "proxy", "raw"] },
            "allow": { "description": "Hosts on the proxy tier, host:port pairs on raw.", "type": "array", "items": { "type": "string" } }
          }
        },
        "setup": { "type": "boolean" },
        "acknowledges": { "description": "A source's: it acknowledges upstream once a checkpoint commits.", "type": "boolean" },
        "splits": { "description": "A source's: it divides streams into splits.", "type": "boolean" },
        "resplit": { "description": "A source's: it splits a running split's remainder. Needs splits.", "type": "boolean" },
        "capabilities": {
          "description": "A destination's.",
          "type": "object",
          "required": ["class"],
          "additionalProperties": false,
          "properties": {
            "class": { "enum": ["stage_and_apply", "transactional_stream", "deliver_and_ack"] },
            "scopes": { "type": "array", "items": { "enum": ["pipeline", "stream"] } },
            "dedupeAtApply": { "type": "boolean" },
            "defaultCommitInterval": { "$ref": "#/$defs/duration" },
            "minCommitInterval": { "$ref": "#/$defs/duration" },
            "maxCommitInterval": { "$ref": "#/$defs/duration" },
            "nanosecondTimestamps": { "type": "boolean" },
            "maxIdentifierLength": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "writeModes": { "description": "None: append only.", "type": "array", "items": { "enum": ["append", "overwrite", "merge"] } },
            "delivery": { "description": "How epochs reach it: streamed as batches, or staged as Parquet files the platform hands over. None: streamed.", "enum": ["streamed", "staged"] },
            "maxWriterLanes": { "description": "The most writer lanes an attempt may open, writing concurrently. None: one.", "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "holds": {
              "description": "What the destination does with held columns and cells. None: it takes no holds.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "byKey": { "description": "Patches a merge stream's rows by their key.", "type": "boolean" },
                "byId": { "description": "Patches an append stream's rows by their _openetl_id.", "type": "boolean" },
                "last": { "description": "A held cell can keep the target's value, in a merge stream.", "type": "boolean" },
                "guarded": { "description": "A patch fills a cell only where the target still holds the version it comes from.", "type": "boolean" }
              }
            }
          }
        },
        "config": { "description": "The config's JSON Schema, as Spec returns it.", "type": "object" }
      },
      "if": { "properties": { "runtime": { "required": ["manifest"] } } },
      "then": {
        "description": "A manifest's config and egress are in the manifest, and it speaks no protocol.",
        "properties": {
          "runtime": { "not": { "anyOf": [{ "required": ["binaries"] }, { "required": ["image"] }] } },
          "requires": { "not": { "required": ["protocol"] } }
        },
        "not": { "anyOf": [{ "required": ["egress"] }, { "required": ["config"] }, { "required": ["capabilities"] }] }
      },
      "else": {
        "required": ["requires", "egress", "config"],
        "properties": { "requires": { "required": ["protocol"] } }
      }
    },
    "source": {
      "allOf": [{ "$ref": "#/$defs/role" }],
      "not": { "required": ["capabilities"] }
    },
    "destination": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "required": ["capabilities"] },
        { "properties": { "runtime": { "not": { "required": ["manifest"] } } } }
      ],
      "not": { "anyOf": [{ "required": ["acknowledges"] }, { "required": ["splits"] }, { "required": ["resplit"] }] }
    }
  }
}
